PORT=8787
FRONTEND_ORIGIN=http://localhost:5173,https://nevxrr.github.io

# Telegram Login Widget — set in BotFather, never commit real values
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Comma-separated numeric Telegram user ids. Those accounts get the teacher role.
TELEGRAM_TEACHER_IDS=

# Optional. If empty, a random key is generated at process start (local only).
JWT_SECRET=

# Demo login without the widget. Defaults to true when TELEGRAM_BOT_TOKEN is empty.
ALLOW_DEV_LOGIN=

DATA_DIR=./data
